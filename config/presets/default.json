{
  "schema": "xr1-preset.v1",
  "id": "default",
  "name": "ETS2 Balanced Simulation (Default)",
  "author": "FanX",
  "game": "Euro Truck Simulator 2",
  "version": "1.1.0",
  "description": "Factory calibrated force feedback and full 6-speed H-shifter bindings for authentic everyday trucking.",
  "tags": ["ETS2", "Simulation", "Balanced", "H-Shifter"],
  "easy_settings": {
    "strength": 75,
    "centering": 65,
    "weight": 70,
    "vibration": 50
  },
  "ffb": {
    "c_ff_enabled": 1.0,
    "c_ff_gain": 8.0,
    "c_ff_hi_spd": 1.45,
    "c_ff_lo_spd": 0.85,
    "c_ff_fricton": 0.75,
    "c_ff_engine": 0.30,
    "c_ff_surface": 0.25,
    "c_ff_bumps": 0.80,
    "c_ff_collis": 0.85,
    "c_ff_gearbox": 0.30,
    "c_ff_undrstr": 0.70,
    "c_ff_assist": 0.50
  },
  "buttons": {
    "parkingbrake": "keyboard.space?0 | joy.b15?0",
    "gearboxhshifter": "1",
    "gearbox": "2",
    "hshifter_toggle1": "joy.b23?0",
    "hshifter_gear1": "joy.b16?0",
    "hshifter_gear2": "joy.b17?0",
    "hshifter_gear3": "joy.b18?0",
    "hshifter_gear4": "joy.b19?0",
    "hshifter_gear5": "joy.b20?0",
    "hshifter_gear6": "joy.b21?0",
    "hshifter_gear_r": "joy.b22?0"
  }
}
